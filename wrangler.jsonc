{
  "name": "webrps",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
  // Secreto necesario (Cloudflare > webrps > Settings > Variables and Secrets):
  // DISCORD_WEBHOOK_URL = URL del webhook del canal de testers en Discord
}
